# ==== LLM（OpenAI 兼容接口，默认 DeepSeek；本地 Ollama 示例见注释）====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 本地 Ollama 示例（无需 API key，随便填一个非空值）：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b-instruct

# ==== 搜索（tavily / duckduckgo）====
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=tvly-xxx

# ==== Langfuse 可观测（可选，两个 key 都配置才启用）====
# 自托管：docker compose up -d langfuse-web，首次启动会用下面的 INIT 变量自动建好项目和账号
# 云端：在 cloud.langfuse.com 建项目后把 key 填到前两行，并删掉 ENCRYPTION_KEY
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# 自托管初始化（仅 docker compose 需要）
LANGFUSE_INIT_USER_EMAIL=demo@local.dev
LANGFUSE_INIT_USER_PASSWORD=change-me
ENCRYPTION_KEY=

# ==== 研究规模控制 ====
MAX_SUBQUESTIONS=4
MAX_SEARCH_ROUNDS=2
# 自定义规模的合法范围（Web/CLI 可按次覆盖；越界直接报错，避免 rounds<=0 静默产出空报告）
MAX_SUBQUESTIONS_LIMIT=8
MAX_SEARCH_ROUNDS_LIMIT=5
MAX_RESULTS_PER_SEARCH=5
MAX_PAGE_CHARS=6000
FETCH_TIMEOUT=15

# ==== W3 A/B 调优开关（eval 实验用）====
RESEARCH_PAGE_CHARS=1200
NOTE_MIN_CHARS=200
NOTE_MAX_CHARS=350
WRITER_STRICT_GROUNDING=0

# ==== 全局预算（长流程硬闸门，任一维度超限即停止新增检索分支并收敛出报告）====
MAX_LLM_CALLS=40
MAX_TOTAL_TOKENS=120000
MAX_WALL_CLOCK_S=900
MAX_BUDGET_USD=0.5

# ==== 重规划（verifier 报告缺口/冲突后回到 planner 追加子问题）====
MAX_REPLAN_ROUNDS=1
MAX_FOLLOWUP_SUBQUESTIONS=2

# ==== 人工审核点位（human-in-the-loop）====
# 逗号分隔：brief=审核任务书 / plan=审核子问题；none 或留空 = 全自动不中断
# plan 点位只对首次规划生效（重规划不再中断）；子问题数低于 PLAN_REVIEW_MIN_SUBQUESTIONS 时不暂停
REVIEW_POINTS=brief
PLAN_REVIEW_MIN_SUBQUESTIONS=0

# ==== 上下文压缩（笔记正文超阈值时压缩后再进核查/撰写；来源列表不受影响）====
COMPACTION_ENABLED=1
COMPACT_TRIGGER_CHARS=12000
COMPACT_TARGET_CHARS=4000

# ==== 外部依赖容错 ====
SEARCH_RETRIES=2
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_S=60
GRAPH_RECURSION_LIMIT=50

# ==== 研究档案（长期记忆：跨运行复用子问题笔记）====
# 默认关闭：开启后命中记忆的子问题直接复用历史笔记、不再检索（会改变评测对照条件）
MEMORY_ENABLED=0
MEMORY_DB=memory.db
MEMORY_SIMILARITY_THRESHOLD=0.62
MEMORY_MAX_AGE_DAYS=30
MEMORY_MAX_HITS=4

# ==== 模型行为 ====
# Ollama 原生路径的上下文窗口（提示词逼近上限时会在 stderr 告警，避免静默截断）
OLLAMA_NUM_CTX=8192
