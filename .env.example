# ==== LLM（OpenAI 兼容接口，默认 DeepSeek；本地 Ollama 示例见注释）====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 本地 Ollama 示例（无需 API key，随便填一个非空值）：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b-instruct

# ==== 搜索（tavily / duckduckgo）====
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=tvly-xxx

# ==== Langfuse 可观测（可选，两个 key 都配置才启用）====
# 自托管：docker compose up -d langfuse-web，首次启动会用下面的 INIT 变量自动建好项目和账号
# 云端：在 cloud.langfuse.com 建项目后把 key 填到前两行，并删掉 ENCRYPTION_KEY
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# 自托管初始化（仅 docker compose 需要）
LANGFUSE_INIT_USER_EMAIL=demo@local.dev
LANGFUSE_INIT_USER_PASSWORD=change-me
ENCRYPTION_KEY=

# ==== 研究规模控制 ====
MAX_SUBQUESTIONS=4
MAX_SEARCH_ROUNDS=2
MAX_RESULTS_PER_SEARCH=5
MAX_PAGE_CHARS=6000
FETCH_TIMEOUT=15

# ==== W3 A/B 调优开关（eval 实验用）====
RESEARCH_PAGE_CHARS=1200
NOTE_MIN_CHARS=200
NOTE_MAX_CHARS=350
WRITER_STRICT_GROUNDING=0
